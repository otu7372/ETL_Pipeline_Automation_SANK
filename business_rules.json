{
  "_provenance": "DOC = stated in lab DDL/SQL (authoritative). INF = inferred from data profiling; confirm with BA before treating a failure as a defect.",

  "domains": {
    "status":            ["APPROVED", "REJECTED", "CANCELLED"],
    "dm_status":         ["APPROVED"],
    "product_type_raw":  ["MF", "SIP", "Equity Fund", "Debt Fund", "INS", "Insurance", "ULIP"],
    "region_code":       ["NORTH", "SOUTH", "EAST", "WEST", "CENTRAL"],
    "gender":            ["M", "F", "O"],
    "kyc_status":        ["VERIFIED", "PENDING", "REJECTED"],
    "customer_segment":  ["RETAIL", "HNI", "PREMIUM", "CORPORATE"],
    "yn":                ["Y", "N"],
    "product_family":    ["MF", "INS"],
    "product_category":  ["MUTUAL_FUND", "INSURANCE"]
  },

  "patterns": {
    "distributor_txn_id": "^DSC\\d{14}$",
    "dist_customer_id":   "^CUST\\d+$",
    "master_customer_id": "^CUC\\d+$",
    "pan":                "^[A-Z]{5}[0-9]{4}[A-Z]$",
    "email":              "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
    "mobile":             "^[0-9]{10}$",
    "pincode":            "^[0-9]{6}$",
    "product_code":       "^(MF|INS)_[A-Z0-9_]+$",
    "dm_etl_run_id":      "^DM-ETL-\\d{8}-\\d{2}$"
  },

  "family_rules": {
    "MF": {
      "product_types": ["MF", "SIP", "Equity Fund", "Debt Fund"],
      "category": "MUTUAL_FUND",
      "required_fields": ["units_allocated", "nav_at_purchase", "folio_number"],
      "forbidden_fields": ["premium_amount", "sum_assured"]
    },
    "INS": {
      "product_types": ["INS", "Insurance", "ULIP"],
      "category": "INSURANCE",
      "required_fields": ["premium_amount", "sum_assured"],
      "forbidden_fields": ["units_allocated", "nav_at_purchase", "folio_number"]
    }
  },

  "thresholds": {
    "commission_pct_max": 15,
    "commission_pct_tolerance": 0.0011,
    "amount_tolerance": 0.01,
    "units_x_nav_tolerance_abs": 1.0,
    "high_value_gross_threshold": 100000,
    "customer_age_min": 0,
    "customer_age_max": 120,
    "min_customer_age_at_onboarding": 18,
    "optional_blank_max_pct": {
      "dist": {"distributor_name": 5, "customer_id": 1, "customer_pan": 5, "region_code": 5},
      "fact": {"customer_key": 1}
    },
    "min_sale_date": "2000-01-01"
  },

  "rule_status": {
    "net_amount = gross_amount - commission_amount": "INF (100% of rows conform)",
    "commission_pct = commission_amount / gross_amount * 100": "INF (100% of rows conform)",
    "MF: units_allocated x nav_at_purchase ~ gross_amount": "INF (100% of rows conform)",
    "is_high_value_flag = (gross_amount >= 100000)": "INF (100% of rows conform)",
    "family field population (MF vs INS)": "INF (100% of rows conform)",
    "sale_date = date(created_at)": "INF (100% of rows conform)",
    "status, product_type, region, gender, kyc, segment domains": "DOC (CHECK constraints)",
    "commission <= gross, commission_pct 0..15, txn_count = 1": "DOC (CHECK constraints)",
    "DM only APPROVED, product_family/category derivation, joins": "DOC (02/03 DM scripts)"
  }
}
